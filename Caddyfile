{
	admin off

	# The plugin is not part of Caddy's built-in directive order, so it may only
	# appear inside a `route` unless it is given a position.
	order durable_streams before respond
}

:4437 {
	# The route path IS the client's path — the plugin takes the stream identity
	# straight from r.URL.Path with no prefix stripping. The client addresses
	# `<server>/streams/<name>`, so this must be `/streams/*`. The upstream
	# README's example uses `/v1/stream/*`, which silently matches nothing here.
	handle /streams/* {
		durable_streams {
			# File-backed (LMDB). Omit this and storage is in-memory, which
			# forgets every run the moment the pod moves.
			data_dir /data
		}
	}
}
